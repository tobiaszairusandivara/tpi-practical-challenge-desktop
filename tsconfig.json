{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts"
  ]
}
